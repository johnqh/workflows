diff --git a/apple/RNSkMetalCanvasProvider.mm b/apple/RNSkMetalCanvasProvider.mm
--- a/apple/RNSkMetalCanvasProvider.mm
+++ b/apple/RNSkMetalCanvasProvider.mm
@@ -92,8 +92,17 @@
 
 void RNSkMetalCanvasProvider::setSize(int width, int height) {
   _layer.frame = CGRectMake(0, 0, width, height);
+#if TARGET_OS_OSX
+  // [macOS] contentsScale is managed by SkiaUIView; read it for pixel size.
+  CGFloat scale = _layer.contentsScale;
+  if (scale <= 0)
+    scale = _context->getPixelDensity();
+  auto w = (int)(width * scale);
+  auto h = (int)(height * scale);
+#else
   auto w = width * _context->getPixelDensity();
   auto h = height * _context->getPixelDensity();
+#endif
 #if defined(SK_GRAPHITE)
   _ctx = RNSkia::DawnContext::getInstance().MakeWindow((__bridge void *)_layer,
                                                        w, h, _highBitDepth);
diff --git a/apple/SkiaUIView.mm b/apple/SkiaUIView.mm
--- a/apple/SkiaUIView.mm
+++ b/apple/SkiaUIView.mm
@@ -113,6 +113,9 @@
 - (void)layoutSubviews {
   [super layoutSubviews];
   if (_impl != nullptr) {
+#if TARGET_OS_OSX
+    [self _updateSkiaLayerScale];
+#endif
     [CATransaction begin];
     [CATransaction setDisableActions:YES];
     _impl->setSize(self.bounds.size.width, self.bounds.size.height);
@@ -120,6 +123,30 @@
   }
 }
 
+#if TARGET_OS_OSX
+- (void)_updateSkiaLayerScale {
+  if (_impl == nullptr)
+    return;
+  CGFloat scale = self.window ? self.window.backingScaleFactor
+                              : [NSScreen mainScreen].backingScaleFactor;
+  CALayer *skiaLayer = _impl->getLayer();
+  if (skiaLayer) {
+    skiaLayer.contentsScale = scale;
+  }
+}
+
+- (void)viewDidChangeBackingProperties {
+  [super viewDidChangeBackingProperties];
+  if (_impl != nullptr) {
+    [self _updateSkiaLayerScale];
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    _impl->setSize(self.bounds.size.width, self.bounds.size.height);
+    [CATransaction commit];
+  }
+}
+#endif // TARGET_OS_OSX
