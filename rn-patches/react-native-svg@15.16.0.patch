+// Fabric calls Invalidate once for every descendant that is mounted, updated
+// or unmounted, and each call rebuilt the whole D2D document and redrew it on
+// the UI thread. A commit that touches N elements of an N-element drawing was
+// therefore N full redraws -- seconds of UI-thread time for a page of notation,
+// during which no JS timer fires either (RNW posts them through the UI thread).
+// One redraw per batch of invalidations, after the mount transaction is done.
 void SvgView::Invalidate() {
+  if (m_drawPending) {
+    return;
+  }
+  auto view = m_wkView.get();
+  if (!view) {
+    return;
+  }
+  winrt::Microsoft::ReactNative::IReactDispatcher dispatcher{nullptr};
+  if (auto context = view.ReactContext()) {
+    dispatcher = context.UIDispatcher();
+  }
+  if (!dispatcher) {
+    DrawNow();
+    return;
+  }
+  m_drawPending = true;
+  dispatcher.Post([wkThis = get_weak()]() {
+    if (auto strongThis = wkThis.get()) {
+      strongThis->m_drawPending = false;
+      strongThis->DrawNow();
+    }
+  });
+}
